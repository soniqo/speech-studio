<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WKWebView/JavaScriptCore uses MAP_JIT pages for the JS JIT; without
	     this the WebView crashes at launch under hardened runtime. Load-bearing. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Microphone access for capturing reference clips that get cloned.
	     Must be paired with NSMicrophoneUsageDescription in Info.plist (added
	     by the build workflow). Use the non-sandbox form of the entitlement
	     since we ship as a notarized DMG, not via the Mac App Store. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
