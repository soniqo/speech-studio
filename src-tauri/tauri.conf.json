{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech Studio",
  "version": "0.0.5",
  "identifier": "audio.soniqo.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Speech Studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3N0E3QTBGNkRCNjQ3NjIKUldSaVI3WnREM3A2aDAxWDRXNDV1REJQNk1wdEZuYzdwUUxRa2xXVy9MOEprazhGWXRaTTErbSsK",
      "endpoints": [
        "https://github.com/soniqo/speech-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
